# Template for provisioning participant.env in the workshop VMs.
# The real values are prepared before students start the course.

WORKSHOP_NAME=preparation-for-ai
PARTICIPANT_ID=01

S3_ENDPOINT_URL=https://s3.example.invalid
S3_VERIFY_SSL=true
PARTICIPANT_BUCKET=preparation-for-ai-01
SHARED_BUCKET=preparation-for-ai-shared
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me

ICEBERG_REST_URI=https://polaris.example.invalid/api/catalog
ICEBERG_REST_INTERNAL_URI=http://polaris.platform.svc.cluster.local:8181/api/catalog
# Optional. If omitted, the labs use <catalog-uri>/v1/oauth/tokens.
# POLARIS_OAUTH_TOKEN_URI=https://polaris.example.invalid/api/catalog/v1/oauth/tokens
# POLARIS_OAUTH_TOKEN_INTERNAL_URI=http://polaris.platform.svc.cluster.local:8181/api/catalog/v1/oauth/tokens
ICEBERG_CATALOG_ALIAS=course
POLARIS_CATALOG_NAME=preparation_for_ai
POLARIS_SCOPE=PRINCIPAL_ROLE:ALL
ICEBERG_NAMESPACE=preparation_for_ai_01
POLARIS_CLIENT_ID=replace-me
POLARIS_CLIENT_SECRET=replace-me

AIRFLOW_URL=http://airflow.example.invalid
AIRFLOW_USERNAME=replace-me
AIRFLOW_PASSWORD=replace-me

SUPERSET_URL=http://superset.example.invalid
SUPERSET_USERNAME=replace-me
SUPERSET_PASSWORD=replace-me

MLFLOW_TRACKING_URI=https://mlflow.example.invalid
